--- /dev/null	2026-09-15 21:52:30.000000000 +0800
+++ "./w-web-perm�\232��\231\204�\207�\226\231/src/components/RelationChips.vue"	2026-09-15 21:52:29.978398800 +0800
@@ -0,0 +1,149 @@
+<template>
+    <span style="white-space:nowrap;">
+
+        <!-- 展開全部: 固定在最左, 不隨 chip 溢出被裁; 點擊以浮層列出全部 chip(可換行、可捲動) -->
+        <!-- WPopup(WTooltip) 之 displayType: 'block' 為 inline-block、'line' 為 block(命名與 CSS 相反), 此處須為行內元素以與其後之 chip 同列 -->
+        <template v-if="n > 0">
+            <WPopup
+                style="vertical-align:middle;"
+                :displayType="'block'"
+                :isolated="true"
+                :placement="'bottom-start'"
+                :paddingStyle="{v:8,h:10}"
+                :minWidth="320"
+                :maxWidth="560"
+                :labelContent="labelContentAll"
+            >
+                <template v-slot:trigger>
+                    <div
+                        :style="`display:inline-flex; align-items:center; box-sizing:border-box; height:22px; margin-right:4px; padding:0 6px; border:1px solid ${hoverAll?'#888':'#aaa'}; border-radius:4px; background:${hoverAll?'#f5f5f5':'#fff'}; color:${hoverAll?'#333':'#555'}; font-size:12px; line-height:20px; vertical-align:middle; cursor:pointer; user-select:none; transition:all 0.3s;`"
+                        :title="tooltipAll"
+                        @mouseenter="hoverAll=true"
+                        @mouseleave="hoverAll=false"
+                    >
+                        <WIcon
+                            :icon="mdiDotsHorizontal"
+                            :size="14"
+                            :color="hoverAll?'#333':'#555'"
+                            :colorHover="'#333'"
+                        ></WIcon>
+                        <span style="padding-left:3px;">{{ n }}</span>
+                    </div>
+                </template>
+                <template v-slot:content>
+                    <div style="font-size:12px; color:#666; padding-bottom:6px;">
+                        {{ usePopupTitle }}
+                    </div>
+                    <!-- 最大高 50vh: 於 900px 高之視窗自列位往下展開仍留得住底邊, 超過即於浮層內捲動 -->
+                    <div style="display:flex; flex-wrap:wrap; gap:4px 6px; max-height:50vh; max-width:540px; overflow:auto;">
+                        <RelationChip
+                            v-for="(item, kitem) in itemsSorted"
+                            :key="`p-${kitem}`"
+                            :name="item.name"
+                            :mode="item.mode"
+                            :isCurrent="item.enable==='y'"
+                            :editable="false"
+                            :nameMaxWidth="600"
+                        ></RelationChip>
+                    </div>
+                </template>
+            </WPopup>
+        </template>
+
+        <!-- 儲存格內之 chip: 本項永遠第 1 顆; 相鄰間距 4px; 溢出由儲存格裁切 -->
+        <RelationChip
+            v-for="(item, kitem) in itemsSorted"
+            :key="`c-${kitem}`"
+            :style="`margin-right:4px;`"
+            :name="item.name"
+            :mode="item.mode"
+            :isCurrent="item.enable==='y'"
+            :editable="editable"
+            :labelContent="labelContent"
+            @input="(item)=>{$emit('input',item)}"
+        ></RelationChip>
+
+    </span>
+</template>
+
+<script>
+import { mdiDotsHorizontal } from '@mdi/js/mdi.js'
+import get from 'lodash-es/get.js'
+import size from 'lodash-es/size.js'
+import filter from 'lodash-es/filter.js'
+import WIcon from 'w-component-vue/src/components/WIcon.vue'
+import WPopup from 'w-component-vue/src/components/WPopup.vue'
+import RelationChip from './RelationChip.vue'
+
+
+//關聯 chip 列表(供 VeGrupBlngUsers 之「所屬權限群組名稱」欄與 VePemiBlngGrups 之「所屬權限名稱」欄)
+//  - items: genItems 產生之 grups/pemis 陣列, 各項含 name、mode、enable('y' 為本項)
+//  - 顯示順序: enable='y'(本項)永遠第 1 顆, 其餘依原順序; 只改顯示, 不改儲存之 cgrups/cpemis 字串(權限合併結果與順序無關, 見 mShare.mjs 之 mergeRules)
+//  - 本項 chip 之模式段即下拉(RelationChip 之 ModeSelectChip), 變更以 input 事件回傳新模式, 由呼叫端沿用既有 showXxxToggleItemModeByName 處理
+//  - 「展開全部」鈕固定於最左, 浮層(WPopup, Teleport 至 body, 與 WDialog 共用 z-index 池故可疊於對話框上)內以 flex-wrap 列出全部 chip
+export default {
+    components: {
+        WIcon,
+        WPopup,
+        RelationChip,
+    },
+    props: {
+        items: {
+            type: Array,
+            default: () => [],
+        },
+        editable: {
+            type: Boolean,
+            default: false,
+        },
+        popupTitle: { //浮層標題所用之欄名(如「所屬權限名稱」), 與數量合成 chipsPopupTitle
+            type: String,
+            default: '',
+        },
+        tooltipAll: {
+            type: String,
+            default: '',
+        },
+        labelContent: { //本項 chip 之模式下拉浮層之 wtlp 屬性值
+            type: String,
+            default: 'modeSelect',
+        },
+        labelContentAll: { //展開全部之浮層之 wtlp 屬性值
+            type: String,
+            default: 'relationChipsAll',
+        },
+    },
+    data: function() {
+        return {
+            mdiDotsHorizontal,
+            hoverAll: false,
+        }
+    },
+    computed: {
+
+        n: function() {
+            let vo = this
+            return size(vo.items)
+        },
+
+        itemsSorted: function() {
+            let vo = this
+            let a = filter(vo.items, (v) => get(v, 'enable', '') === 'y')
+            let b = filter(vo.items, (v) => get(v, 'enable', '') !== 'y')
+            return [...a, ...b]
+        },
+
+        usePopupTitle: function() {
+            let vo = this
+            let t = vo.$t('chipsPopupTitle')
+            t = t.replace('{title}', vo.popupTitle)
+            t = t.replace('{n}', vo.n)
+            return t
+        },
+
+    },
+}
+</script>
+
+<style scoped>
+</style>
